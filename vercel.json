{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["app/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/css/(.*)", "dest": "frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "frontend/js/$1" },
    { "src": "/(.*\\.html)", "dest": "frontend/$1" },
    { "src": "/(.*\\.ico)", "dest": "frontend/$1" },
    { "src": "/(.*\\.png)", "dest": "frontend/$1" },
    { "src": "/(.*\\.jpg)", "dest": "frontend/$1" },
    { "src": "^/$", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
